# Server-only. Copy to .env.local; NEVER use NEXT_PUBLIC_ for these values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Exact browser origin (scheme + hostname + port). Change when deploying.
APP_ORIGIN=http://127.0.0.1:3000
# Required in production when AI is enabled. At least 24 characters.
# User enters this app access code in Settings, NOT the OpenAI API key.
AI_ACCESS_TOKEN=
